# Copie para .env e preencha. Nunca versione o .env.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=auditor.seudominio.com.br,localhost
CSRF_TRUSTED_ORIGINS=https://auditor.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://auditor.seudominio.com.br
# Endereço público usado nos links /r/{token} enviados aos clientes
PUBLIC_BASE_URL=https://auditor.seudominio.com.br
# Host das prévias dos sites gerados (separado do painel)
SITES_BASE_URL=https://previa.seudominio.com.br
# 2FA é obrigatório sempre que DJANGO_DEBUG=false; só dá para desligar em desenvolvimento
# REQUIRE_2FA=true

# --- Banco e filas (preenchidos pelo docker-compose; defina só a senha) ---
POSTGRES_PASSWORD=troque-esta-senha
# DATABASE_URL=postgres://auditor:senha@localhost:5432/auditor
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Descoberta gratuita (ligada por padrão) ---
# OpenStreetMap via Overpass (servidores públicos, uso moderado; tenta o próximo se um estiver ocupado)
OSM_ENABLED=true
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Testa o domínio do e-mail cadastrado na Receita (ex.: contato@clinica.com.br) como site da empresa
EMAIL_DOMAIN_DISCOVERY=true

# --- Integrações pagas/opcionais (sem chave, a etapa aparece como "não medida") ---
# Google Places é opcional: maior cobertura e traz nota/avaliações do Google
GOOGLE_PLACES_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# --- IA da análise qualitativa (opcional) ---
# Gemini gratuito (chave em aistudio.google.com). Basta preencher a chave.
GEMINI_API_KEY=
# AI_MODEL=gemini-flash-latest   (apelido do Flash mais recente; ou fixe, ex.: gemini-3.8-flash)
# Claude (pago): ANTHROPIC_API_KEY=...  e, se houver mais de uma chave, AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# IA local com Ollama (sem internet): AI_PROVIDER=openai_compat, AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=qwen3.5:4b
# OpenRouter/Groq: AI_PROVIDER=openai_compat, AI_BASE_URL=<endpoint /v1>, AI_API_KEY=<chave>, AI_MODEL=<modelo>
# Teto mensal para APIs pagas em R$ (alerta a 80%)
MONTHLY_API_BUDGET_BRL=500

# --- Motor de auditoria ---
LIGHTHOUSE_RUNS=3
AUDIT_TIMEOUT=300
AUDIT_PARALLELISM=5
CRAWLER_MAX_PAGES=10
CRAWLER_USER_AGENT=AuditorDeSitesBot/1.0 (+https://seudominio.com.br/robo; auditoria de sites publicos)

# --- Retenção (LGPD) ---
ARTIFACT_RETENTION_DAYS=365
REPORT_DEFAULT_EXPIRY_DAYS=60
SEARCH_CACHE_DAYS=30

# --- Armazenamento S3 (opcional; sem isso usa o volume local "media") ---
# AWS_STORAGE_BUCKET_NAME=auditor-sites
# AWS_S3_REGION_NAME=sa-east-1
# AWS_S3_ENDPOINT_URL=          # preencha para MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Observabilidade ---
SENTRY_DSN=
FLOWER_USER=admin
FLOWER_PASSWORD=troque-esta-senha
